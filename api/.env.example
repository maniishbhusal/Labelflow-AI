DJANGO_SECRET_KEY=replace-with-a-generated-secret
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# Copy the S3 API endpoint from the bucket's Cloudflare dashboard. For an EU
# jurisdictional bucket it looks like https://<account-id>.eu.r2.cloudflarestorage.com
R2_ENDPOINT_URL=
R2_UPLOAD_URL_TTL_SECONDS=300
R2_READ_URL_TTL_SECONDS=900
MAX_IMAGE_UPLOAD_BYTES=10485760
